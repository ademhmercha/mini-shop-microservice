{
  "uid": "shoplite-red",
  "title": "ShopLite",
  "tags": ["shoplite"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requêtes par seconde (par service)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "{{service}}",
        "expr": "sum by (service) (rate(http_requests_total{namespace=\"shoplite\"}[$__rate_interval]))" } ] },
    { "id": 2, "type": "timeseries", "title": "Taux d'erreurs 5xx (par service)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }, "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "{{service}}",
        "expr": "sum by (service) (rate(http_requests_total{namespace=\"shoplite\",status=~\"5..\"}[$__rate_interval])) / sum by (service) (rate(http_requests_total{namespace=\"shoplite\"}[$__rate_interval]))" } ] },
    { "id": 3, "type": "timeseries", "title": "Durée des requêtes p95 (par service)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }, "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "{{service}}",
        "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{namespace=\"shoplite\"}[$__rate_interval])))" } ] },
    { "id": 4, "type": "timeseries", "title": "Auth : connexions réussies et échouées (par seconde)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }, "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "réussies", "expr": "sum(rate(auth_logins_succeeded_total{namespace=\"shoplite\"}[$__rate_interval]))" },
        { "refId": "B", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "échouées", "expr": "sum(rate(auth_logins_failed_total{namespace=\"shoplite\"}[$__rate_interval]))" } ] },
    { "id": 5, "type": "stat", "title": "Auth : connexions réussies (période)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 16 },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(increase(auth_logins_succeeded_total{namespace=\"shoplite\"}[$__range]))" } ] },
    { "id": 6, "type": "stat", "title": "Auth : connexions échouées (période)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 16 },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(increase(auth_logins_failed_total{namespace=\"shoplite\"}[$__range]))" } ] },
    { "id": 7, "type": "stat", "title": "Auth : verrouillages de compte (période)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 16 },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "expr": "sum(increase(auth_lockouts_total{namespace=\"shoplite\"}[$__range]))" } ] },
    { "id": 8, "type": "timeseries", "title": "Auth : verrouillages de compte (par seconde)", "datasource": {"type":"prometheus","uid":"prometheus"},
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 16 },
      "targets": [ { "refId": "A", "datasource": {"type":"prometheus","uid":"prometheus"}, "legendFormat": "verrouillages", "expr": "sum(rate(auth_lockouts_total{namespace=\"shoplite\"}[$__rate_interval]))" } ] }
  ]
}

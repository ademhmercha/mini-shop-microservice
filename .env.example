# Variables lues par docker-compose.yml. Ne copiez pas ce fichier à la main :
# `node scripts/gen-keys.mjs` crée un .env avec des valeurs aléatoires (ignoré par Git).
JWT_KEY_ID=key-1
POSTGRES_PASSWORD=
AUTH_DB_OWNER_PASSWORD=
AUTH_DB_APP_PASSWORD=
CATALOG_DB_OWNER_PASSWORD=
CATALOG_DB_APP_PASSWORD=
ORDERS_DB_OWNER_PASSWORD=
ORDERS_DB_APP_PASSWORD=
REDIS_PASSWORD=
# 32 octets en base64 : chiffre les secrets TOTP en base
TOTP_ENCRYPTION_KEY=
# Jeton partagé pour les appels internes (effacement RGPD)
INTERNAL_API_TOKEN=

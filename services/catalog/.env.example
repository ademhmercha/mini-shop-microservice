# Configuration du service catalog - uniquement par variables d'environnement.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# Utilisateur applicatif : lecture seule
DATABASE_URL=postgres://catalog_app:change-me@localhost:5432/catalog_db
# Propriétaire du schéma, utilisé seulement par `npm run migrate`
MIGRATION_DATABASE_URL=postgres://catalog_owner:change-me@localhost:5432/catalog_db

APP_ORIGIN=http://localhost:8080
TRUST_PROXY=1

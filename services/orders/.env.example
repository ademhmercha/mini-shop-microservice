# Configuration du service orders - uniquement par variables d'environnement.
NODE_ENV=development
PORT=3004
LOG_LEVEL=info

DATABASE_URL=postgres://orders_app:change-me@localhost:5432/orders_db
# Propriétaire du schéma, utilisé seulement par `npm run migrate`
MIGRATION_DATABASE_URL=postgres://orders_owner:change-me@localhost:5432/orders_db

APP_ORIGIN=http://localhost:8080
TRUST_PROXY=1

# Les jetons sont vérifiés avec la clé PUBLIQUE publiée par le service auth.
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=shoplite-auth
JWT_AUDIENCE=shoplite

# Services appelés (délai d'attente strict)
CART_URL=http://localhost:3003
CATALOG_URL=http://localhost:3002
UPSTREAM_TIMEOUT_MS=3000

# Jeton partagé pour l'anonymisation RGPD déclenchée par auth (optionnel, 16 caractères minimum)
# INTERNAL_API_TOKEN=

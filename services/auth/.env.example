# Configuration du service auth - uniquement par variables d'environnement.
# Copiez ce fichier en .env pour un lancement hors Docker. Ne commitez jamais .env.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Utilisateur applicatif (droits DML uniquement)
DATABASE_URL=postgres://auth_app:change-me@localhost:5432/auth_db
# Utilisateur propriétaire du schéma, utilisé seulement par `npm run migrate`
MIGRATION_DATABASE_URL=postgres://auth_owner:change-me@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379/0

# Origine exacte du site (CORS, vérification CSRF, liens des e-mails)
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=1

# Jetons : clé privée Ed25519 (PEM) fournie par fichier monté OU variable, jamais commitée.
# Générez-la avec : node scripts/gen-keys.mjs  (à la racine du projet)
JWT_PRIVATE_KEY_FILE=../../.secrets/jwt-private.pem
# JWT_PRIVATE_KEY=
JWT_KEY_ID=key-1
# Rotation : dossier contenant les anciennes clés publiques <kid>.pem (encore acceptées en vérification)
# JWT_RETIRED_PUBLIC_KEYS_DIR=
JWT_ISSUER=shoplite-auth
JWT_AUDIENCE=shoplite
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Chiffrement des secrets TOTP (32 octets en base64)
TOTP_ENCRYPTION_KEY=

# E-mails (Mailpit en local)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Maison Argile <no-reply@maison-argile.local>

# Protection contre la force brute
MAX_FAILED_LOGINS=5
LOCKOUT_SECONDS=900
IP_RATE_LIMIT_MAX=30
IP_RATE_LIMIT_WINDOW_SECONDS=60

# Effacement RGPD dans les autres services (optionnel)
# ORDERS_INTERNAL_URL=http://orders:3004
# CART_INTERNAL_URL=http://cart:3003
# INTERNAL_API_TOKEN=

# Configuration du service cart - uniquement par variables d'environnement.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379/1
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
TRUST_PROXY=1

# Les jetons sont vérifiés avec la clé PUBLIQUE publiée par le service auth.
AUTH_JWKS_URL=http://localhost:3001/.well-known/jwks.json
JWT_ISSUER=shoplite-auth
JWT_AUDIENCE=shoplite

GUEST_CART_TTL_SECONDS=2592000
USER_CART_TTL_SECONDS=7776000

# Jeton partagé pour l'effacement RGPD déclenché par auth (optionnel, 16 caractères minimum)
# INTERNAL_API_TOKEN=
